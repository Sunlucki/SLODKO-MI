# ── Analityka i piksele (wszystkie opcjonalne; puste = wyłączone) ──────────────
# Google Analytics 4 — Measurement ID
VITE_GA_ID=
# Meta (Facebook/Instagram) Pixel ID
VITE_META_PIXEL_ID=
# Google Tag Manager — kontener (opcjonalnie, do dodawania innych pikseli bez kodu)
VITE_GTM_ID=
# TikTok Pixel ID (opcjonalnie)
VITE_TIKTOK_PIXEL_ID=

# ── Adres produkcyjny (canonical, sitemap, og:url) ─────────────────────────────
SITE_URL=https://sunlucki.github.io/SLODKO-MI
# Podścieżka, gdy strona nie stoi w katalogu głównym domeny (np. GitHub Pages: /SLODKO-MI/)
VITE_BASE=/

# ── Opinie Google (scripts/fetch-google-reviews.ts) ────────────────────────────
GOOGLE_PLACES_API_KEY=
# Opcjonalnie — jeśli puste, skrypt sam znajdzie miejsce po nazwie i adresie
GOOGLE_PLACE_ID=

# ── Edycja treści przez LLM (scripts/ai-edit.ts) ───────────────────────────────
# anthropic | openai (dowolne API zgodne z OpenAI: OpenAI, OpenRouter, Groq, Mistral, Gemini, Ollama, LM Studio…)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
# Tylko dla LLM_PROVIDER=openai, np. https://openrouter.ai/api/v1 albo http://localhost:11434/v1
LLM_BASE_URL=

# ── React Bits Pro (rejestr @reactbits-starter, płatna licencja) ───────────────
REACTBITS_LICENSE_KEY=
