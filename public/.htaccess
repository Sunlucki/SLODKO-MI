# SŁODKO MI — Apache (or LiteSpeed) config for shared hosting.
# The site is 100% static: every route is a pre-rendered <path>/index.html, so there is
# no SPA fallback — a URL either maps to a real file/folder or returns the 404 page.
#
# Deploy: upload the CONTENTS of dist/ (including this file) into the web root (public_html/).
#
# ── Subfolder deploy (WordPress stays in public_html/) ───────────────────────────────
#   1. Build with the sub-path:  VITE_BASE=/slodkomi/ SITE_URL=https://example.pl/slodkomi npm run build
#      (in GitHub Actions: repository variables VITE_BASE and SITE_URL, secret FTP_SERVER_DIR=./public_html/slodkomi/)
#   2. Upload dist/ into public_html/slodkomi/.
#   3. In THIS file change:  ErrorDocument 404 /slodkomi/404.html,  ErrorDocument 403 /slodkomi/404.html
#      and   RewriteBase /slodkomi/
#   WordPress' .htaccess in public_html/ does not interfere: its rules skip existing files/folders,
#   and the rewrite rules of this (deeper) .htaccess replace the parent's ones for /slodkomi/.

# If the host answers "500 Internal Server Error", it does not allow Options here — delete this line.
Options -Indexes -MultiViews

DirectoryIndex index.html
# /produkt/oreo → 301 /produkt/oreo/ (matches canonical URLs and the sitemap)
DirectorySlash On
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html
# Folders without an index page (/produkt/, /images/ — Options -Indexes) answer 403: show the site's page, not Apache's
ErrorDocument 403 /404.html

# ── HTTPS + non-www + trailing slash (one 301 hop) ──────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  # RewriteBase /

  # Certificate validation (Let's Encrypt / AutoSSL) must stay reachable over plain HTTP
  RewriteRule ^\.well-known/ - [L]

  # Explicit …/index.html → the folder URL (only for client requests, not internal DirectoryIndex lookups)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^(.*/)?index\.html$ https://%1/$1 [R=301,L,NE]

  # Folder without trailing slash → https://example.pl/…/ (also drops www; DirectorySlash
  # alone would redirect to http:// behind a TLS proxy and cost an extra hop)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule [^/]$ https://%1%{REQUEST_URI}/ [R=301,L,NE]

  # www.example.pl → https://example.pl (any scheme)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  # http → https (X-Forwarded-Proto: hosts that terminate TLS on a proxy)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# ── MIME types ──────────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddType application/xml .xml
  AddType text/plain .txt
  AddCharset UTF-8 .html .css .js .mjs .json .xml .txt .svg .webmanifest
</IfModule>

# ── Compression (Brotli first; mod_deflate skips responses that are already encoded) ─
# AddOutputFilterByType comes from mod_filter — without that guard a host lacking it answers 500 everywhere
<IfModule mod_filter.c>
  <IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
  </IfModule>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_headers.c>
  # ── Caching ───────────────────────────────────────────────────────────────────────
  # HTML & data: always revalidate, so a new deploy is visible immediately (ETag → 304)
  <FilesMatch "\.(html|xml|txt|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # JS/CSS/fonts exist only in /assets/ and carry a content hash in the file name.
  # (Never put un-hashed .js/.css files in public/ — they would be cached for a year.)
  <FilesMatch "\.(js|mjs|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # /images/, /video/ and icons: names are stable, so cache for 7 days
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # ── Security headers ──────────────────────────────────────────────────────────────
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>
